<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.30.xsd">



    <changeSet id="create_beneficiary_table_sequence" author="Roman">
        <createSequence sequenceName="beneficiary_id_sequence" startValue="1" incrementBy="1" />
    </changeSet>

    <changeSet id="create_beneficiary_table" author="Roman">
        <createTable tableName="beneficiary">
            <column name="beneficiary_id" type="bigint" defaultValueSequenceNext="beneficiary_id_sequence">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>